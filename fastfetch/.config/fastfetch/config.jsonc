{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/sbains/dotfiles/fastfetch/.config/fastfetch/ghostty.png",
    "width": 24,
    "height": 12,
    "padding": {
      "top": 5,
      "left": 5,
      "right": 5,
    },
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12,
    },
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
    },
    "break",
    {
      "type": "os",
      "key": "  OS",
      "format": "{pretty-name} {arch}",
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "format": "{release}",
    },
    {
      "type": "de",
      "key": "  DE",
      "format": "{pretty-name}",
    },
    {
      "type": "wm",
      "key": "  WM",
      "format": "{pretty-name} · {protocol-name}",
    },
    "break",
    {
      "type": "shell",
      "key": "  Shell",
    },
    {
      "type": "terminal",
      "key": "  Term",
    },
    {
      "type": "packages",
      "key": "󰏖  Pkgs",
      "format": "{pacman} pacman · {flatpak-all} flatpak",
    },
    "break",
    {
      "type": "cpu",
      "key": "  CPU",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "  RAM",
      "format": "{used} / {total}",
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/",
      "format": "{size-used} / {size-total}",
    },
    "break",
    {
      "type": "custom",
      //      "format": "\u001b[38;2;206;214;223m●  \u001b[38;2;154;177;203m●  \u001b[38;2;147;150;200m●  \u001b[38;2;164;204;209m●  \u001b[38;2;145;153;161m●\u001b[0m",
      "format": "{#97}󰊠 {#36}󰊠 {#96}󰊠 {#35}󰊠 {#95}󰊠 {#34}󰊠 {#94}󰊠 {#33}󰊠 {#93}󰊠 {#32}󰊠 {#92}󰊠 {#31}󰊠 {#91}󰊠 {#30}󰊠 {#90}󰊠 ",
    },
    "break",
  ],
}
